<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
  <display-name>Multiplayer Snake Game</display-name>

  <filter>
    <filter-name>SecurityFilter</filter-name>
    <filter-class>com.snake.game.servlet.SecurityFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>SecurityFilter</filter-name>
    <url-pattern>/api/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>SecurityFilter</filter-name>
    <url-pattern>/api/game/ws/*</url-pattern>
  </filter-mapping>

  <listener>
    <listener-class>com.snake.game.servlet.AppContextListener</listener-class>
  </listener>
</web-app>
