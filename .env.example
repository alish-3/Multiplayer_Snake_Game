# Copy to .env and fill in real values. .env is gitignored.
# Used by docker-compose.yml; loaded automatically by `docker compose up`.

# Password for the PostgreSQL container (used by both the db and app services).
DB_PASSWORD=change_me_strong_password

# JWT_SECRET must be 32+ characters. Changing it invalidates all existing
# remember-me tokens (users would need to log in again).
JWT_SECRET=change_me_to_a_random_32_plus_char_secret
